[Unit]
Description=CBOB read-only vault register and NFT metadata
After=network-online.target
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/cbob-public-data
# pin-public-data.sh installs the reviewed worktree override. Refuse without it.
ExecStart=/usr/bin/false
TimeoutStartSec=480
NoNewPrivileges=true
